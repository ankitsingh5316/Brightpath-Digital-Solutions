# Public site URL used for metadata, sitemap, and canonical tags
NEXT_PUBLIC_SITE_URL=https://www.yourdomains.com

# Google Search Console verification (optional — only applied when set)
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics — configure ONE of GTM or GA4 (not both)
# If GTM is set, GA4 should be configured inside GTM to avoid duplicate hits.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Lead storage: file | webhook | mssql
LEADS_STORAGE=file

# Webhook storage / legacy backend forward
LEADS_WEBHOOK_URL=
CONTACT_API_URL=
CONTACT_API_KEY=

# Email notifications (Resend API key or custom webhook) — server-only secrets
EMAIL_API_KEY=
EMAIL_FROM=leads@yourdomain.com
EMAIL_TO=ankitsingh9660@gmail.com
EMAIL_WEBHOOK_URL=

# SQL Server (only when LEADS_STORAGE=mssql)
# DB_SERVER=
# DB_DATABASE=
# DB_USER=
# DB_PASSWORD=
# DB_ENCRYPT=false
# DB_TRUST_CERT=true
